#!/bin/sh /etc/rc.common
# AUN Filestore - @DESC@ (procd / OpenWrt)
#
# This is an out-of-process service provider: it reaches Econet only through
# filestored's relay, so it will not start unless aun-filestored is running.
# procd has no cross-service "requires", so it starts after filestored (higher
# START) and bails out (procd then respawns it) while filestored is down.

USE_PROCD=1
START=96
STOP=10

PROG=/usr/libexec/aun-filestore/@DAEMON@
CONFDIR=/etc/aun-filestored

find_php() {
	for p in php php84 php83 php82 php8-cli php-cli php8; do
		if command -v "$p" >/dev/null 2>&1; then command -v "$p"; return 0; fi
	done
	echo /usr/bin/php
}

start_service() {
	if ! /etc/init.d/aun-filestored running >/dev/null 2>&1; then
		echo "aun-@DAEMON@: aun-filestored is not running, refusing to start" >&2
		return 1
	fi
	procd_open_instance @DAEMON@
	procd_set_param command "$(find_php)" "$PROG" -c "$CONFDIR"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
