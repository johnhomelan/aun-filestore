#!/bin/sh
# First install: lay out the writable state and seed the config directory
# from the templates shipped inside the package.

PKGNAME="aun-filestored"
PKGDEST="${SYNOPKG_PKGDEST:-/var/packages/${PKGNAME}/target}"
PKGVAR="${SYNOPKG_PKGVAR:-/var/packages/${PKGNAME}/var}"
PKGETC="${SYNOPKG_PKGETC:-/var/packages/${PKGNAME}/etc}"

mkdir -p "${PKGETC}"
mkdir -p "${PKGVAR}/root"
mkdir -p "${PKGVAR}/print-spool"

# The in-process Symfony admin kernel writes its compiled container and logs
# under <target>/var - make sure those exist and are writable.
mkdir -p "${PKGDEST}/var/cache"
mkdir -p "${PKGDEST}/var/log"
chmod -R 0777 "${PKGDEST}/var"

# Seed config only if it is not already there (fresh install).
[ -f "${PKGETC}/default.conf" ] || cp "${PKGDEST}/default.conf.example" "${PKGETC}/default.conf"
[ -f "${PKGETC}/users.txt" ]    || cp "${PKGDEST}/users.txt.example"    "${PKGETC}/users.txt"
[ -f "${PKGETC}/aunmap.txt" ]   || cp "${PKGDEST}/aunmap.txt.example"   "${PKGETC}/aunmap.txt"

exit 0
