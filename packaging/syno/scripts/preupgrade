#!/bin/sh
# Keep a copy of the live config so an upgrade can never clobber it, even if a
# future DSM stops preserving /var/packages/<pkg>/etc across upgrades.

PKGNAME="aun-filestored"
PKGETC="${SYNOPKG_PKGETC:-/var/packages/${PKGNAME}/etc}"
STASH="/var/tmp/${PKGNAME}.etc.upgrade"

if [ -d "${PKGETC}" ]; then
	rm -rf "${STASH}"
	mkdir -p "${STASH}"
	cp -a "${PKGETC}/." "${STASH}/" 2>/dev/null || true
fi

exit 0
