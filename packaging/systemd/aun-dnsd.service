[Unit]
Description=AUN Filestore - Econet DNS service provider
Documentation=https://github.com/johnhomelan/aun-filestore
After=network-online.target aun-filestored.service
Wants=network-online.target
# dnsd reaches Econet only through filestored's remote-socket relay, so it
# cannot run without filestored.
Requires=aun-filestored.service
PartOf=aun-filestored.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/php /usr/libexec/aun-filestore/dnsd -c /etc/aun-filestored
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
